# Copy to .env and fill in. .env is gitignored.
#
# The original put the Firefox profile path in a tracked config.py. A browser
# profile path identifies a person and a machine, and the same pattern in
# another of these repositories published a Windows username and a Firefox
# profile ID.

# Where the labelled images live. Expects liked/ and disliked/ inside it.
SWIPEML_DATA_ROOT=training_data

# Where the trained model goes. Its manifest is written beside it.
SWIPEML_MODEL=models/model.keras

# --- browser automation (optional) ----------------------------------------
# firefox or chrome.
SWIPEML_BROWSER=firefox

# An existing, already-logged-in browser profile. This is how the automation
# never touches your credentials: the browser is already signed in and nothing
# here ever sees a password.
#   Firefox: about:profiles, then the "Root Directory" of the profile you want
#   Chrome:  chrome://version, then "Profile Path"
# Close the browser before running, or the profile will be locked.
SWIPEML_BROWSER_PROFILE=

# The site to drive. Left blank on purpose: the automation commands refuse to
# run until you set it, so a fresh clone cannot point anywhere by accident.
SWIPEML_URL=

# Headless. Off by default, because watching the first run is how you find out
# whether the selectors still match.
SWIPEML_HEADLESS=
